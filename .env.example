# AgTech Unified Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=postgresql://user:password@localhost:5432/agtech_unified

# API Configuration
API_PORT=8000
LOG_LEVEL=INFO
AGTECH_ENV=development

# IoT Configuration
MQTT_BROKER_URL=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TIMESCALEDB_URL=localhost:5432

# GPU Configuration
GPU_ENABLED=false
BATCH_SIZE=32

# Performance
MAX_WORKERS=4
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=*
